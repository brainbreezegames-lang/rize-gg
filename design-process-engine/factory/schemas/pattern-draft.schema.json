{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-process-engine.dev/schemas/pattern-draft.schema.json",
  "title": "PatternDraft",
  "description": "Factory-produced pattern guide draft awaiting curator taste gate before landing in knowledge/patterns.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "title",
    "status",
    "structure",
    "requiredStates",
    "sourceExamples"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Pattern id slug, e.g. otp-input"
    },
    "kind": { "const": "pattern-draft" },
    "title": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "description": "auth, forms, navigation, feedback, commerce, etc."
    },
    "status": {
      "type": "string",
      "enum": ["draft", "pending-review", "approved", "rejected"]
    },
    "proposedTier": {
      "type": "string",
      "enum": ["free", "pro"],
      "default": "pro"
    },
    "structure": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "requiredStates": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "codeExample": { "type": "string" },
    "mistakes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "relatedPatterns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sourceExamples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["app", "journeyId"],
        "properties": {
          "app": { "type": "string" },
          "journeyId": { "type": "string" },
          "stepName": { "type": "string" },
          "screenshotRef": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "prevalence": {
      "type": "object",
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "label": { "type": "string" }
      }
    },
    "draftedAt": { "type": "string", "format": "date-time" },
    "curatorNotes": { "type": "string" }
  }
}
